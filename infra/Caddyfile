# Mentez — servidor web (HTTPS automático)
{
	# Certificado sob demanda: antes de emitir para um endereço novo (subdomínio de clínica ou domínio próprio),
	# o Caddy pergunta ao app se o endereço pertence a uma clínica ativa.
	on_demand_tls {
		ask http://app:3000/_mentez/tls
	}
}

(seg) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	encode zstd gzip
}

www.mentez.com.br {
	redir https://mentez.com.br{uri} permanent
}
www.bemestarmental.com.br {
	redir https://bemestarmental.com.br{uri} permanent
}
# Site de vendas e diretório (provisórios até as próximas etapas)
mentez.com.br {
	import seg
	root * /srv/mentez
	file_server
	# endereço que não existe: página 404 da Mentez (com o mascote)
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/mentez
			rewrite * /404.html
			file_server
		}
	}
}
# Bem-Estar Mental: diretório de psicólogos (servido pelo app); os sites das clínicas (*.bemestarmental.com.br) ficam no bloco https:// abaixo
bemestarmental.com.br {
	import seg
	reverse_proxy app:3000 {
		lb_try_duration 60s
		lb_try_interval 300ms
	}
	handle_errors 502 503 504 {
		root * /srv/mentez
		rewrite * /atualizando.html
		header Cache-Control "no-store"
		file_server {
			status 503
		}
	}
}
# Painel da Mentez e todas as clínicas (slug.mentez.com.br e domínios próprios).
# Ambiente de testes (dev.mentez.com.br e *.dev.mentez.com.br): outro app, com banco próprio e dados fictícios.
https:// {
	tls {
		on_demand
	}
	import seg
	@dev host dev.mentez.com.br *.dev.mentez.com.br
	# Durante uma atualização o app fica alguns segundos fora: o Caddy segura o acesso e tenta de novo
	# (até 60 s) em vez de mostrar erro. Passando disso, mostra a página “Estamos atualizando”, que recarrega sozinha.
	handle @dev {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy app-dev:3000 {
			lb_try_duration 60s
			lb_try_interval 300ms
		}
	}
	handle {
		reverse_proxy app:3000 {
			lb_try_duration 60s
			lb_try_interval 300ms
		}
	}
	handle_errors 502 503 504 {
		root * /srv/mentez
		rewrite * /atualizando.html
		header Cache-Control "no-store"
		header Retry-After "10"
		file_server {
			status 503
		}
	}
}
